{
  "expo": {
    "name": "niCode",
    "slug": "nicode",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nicode",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nisaljunaid.nicode",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.nisaljunaid.nicode",
      "adaptiveIcon": {
        "backgroundColor": "#0E1015",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1015",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "niCode uses Face ID to unlock your server key."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "niCode uses Face ID to unlock your server key."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "niCode uses the camera to scan your server's pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
